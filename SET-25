#=========================================
# Fitness Tracker Analysis
#=========================================

# Create Dataset

fitness <- data.frame(
  User_ID = c(1,2,3,4,5),
  Steps = c(7000,10000,8500,12000,6500),
  Calories_Burned = c(250,400,320,500,220),
  Active_Minutes = c(40,60,50,75,35)
)

print(fitness)


#=========================================
# Create Activity Level Categories
#=========================================

fitness$Activity_Level <- cut(
  fitness$Steps,
  breaks = c(0,7500,10000,15000),
  labels = c("Low Activity",
             "Moderate Activity",
             "High Activity")
)

print(fitness)


#=========================================
# GRAPH 1 : Histogram
# Daily Steps Distribution
#=========================================

hist(
  fitness$Steps,
  col = "lightgreen",
  border = "black",
  main = "Distribution of Daily Steps",
  xlab = "Steps",
  ylab = "Frequency"
)


#=========================================
# GRAPH 2 : Pie Chart
# Activity Level Categories
#=========================================

activity_count <- table(fitness$Activity_Level)

pie(
  activity_count,
  col = c("red","orange","green"),
  main = "Fitness Activity Level Distribution",
  labels = paste(
    names(activity_count),
    activity_count
  )
)


#=========================================
# GRAPH 3 : Bar Chart
# Calories Burned by User
#=========================================

bar <- barplot(
  fitness$Calories_Burned,
  names.arg = paste("User",fitness$User_ID),
  col = c("skyblue",
          "purple",
          "green",
          "orange",
          "pink"),
  main = "Calories Burned by User",
  xlab = "User ID",
  ylab = "Calories Burned"
)

# Add Value Labels

text(
  x = bar,
  y = fitness$Calories_Burned,
  labels = fitness$Calories_Burned,
  pos = 3
)


#=========================================
# GRAPH 4 : Scatter Plot
# Steps vs Calories Burned
#=========================================

plot(
  fitness$Steps,
  fitness$Calories_Burned,
  pch = 19,
  cex = 1.5,
  col = "blue",
  main = "Steps vs Calories Burned",
  xlab = "Daily Steps",
  ylab = "Calories Burned"
)

# Add Trend Line

model <- lm(
  Calories_Burned ~ Steps,
  data = fitness
)

abline(
  model,
  col = "red",
  lwd = 2
)


#=========================================
# Display Fitness Data Table
#=========================================

plot.new()

title("Fitness Tracker Data Table")

table_data <- rbind(
  c("User ID","Steps","Calories","Active Minutes","Activity Level"),
  cbind(
    fitness$User_ID,
    fitness$Steps,
    fitness$Calories_Burned,
    fitness$Active_Minutes,
    fitness$Activity_Level
  )
)

text(
  x = 0.5,
  y = seq(0.9,0.2,length.out = nrow(table_data)),
  labels = apply(table_data,1,paste,collapse="     "),
  cex = 0.8
)


#=========================================
# Save Dataset
#=========================================

write.csv(
  fitness,
  "Fitness_Tracker_Analysis.csv",
  row.names = FALSE
)

cat("Fitness_Tracker_Analysis.csv saved successfully.\n")
